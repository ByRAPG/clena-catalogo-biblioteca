# Variables del despliegue de producción (docker-compose.prod.yml).
# Copia este archivo a `.env.prod` (ignorado por git) y rellena los valores.
# Nunca subas `.env.prod` ni pegues secretos en Issues, PR o chats.

# Dominio público que apunta a esta máquina (registro DNS A/AAAA). Con un
# dominio, Caddy obtiene y renueva el certificado HTTPS solo (puertos 80 y 443
# abiertos). ":80" sirve HTTP sin TLS: solo para pruebas; el inicio de sesión
# necesita HTTPS (la cookie de sesión es Secure).
SITE_ADDRESS=biblioteca.ejemplo.org

# URL pública del sitio (incluye https://). Es el único origen permitido para
# la API (CORS_ORIGIN) y la base de los QR impresos.
PUBLIC_WEB_URL=https://biblioteca.ejemplo.org

# Base de datos. Usa solo letras, números, guion o guion bajo en el usuario y
# el nombre; la contraseña en hexadecimal para que la URL de conexión sea válida.
POSTGRES_USER=clena
POSTGRES_DB=clena_catalogo
# Genera: openssl rand -hex 24
POSTGRES_PASSWORD=

# Secretos JWT (mínimo 32 caracteres; deben ser distintos entre sí).
# Genera cada uno con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcionales (valores por defecto entre paréntesis).
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# LOG_LEVEL=info

# Número de proxies de confianza delante de la API (por defecto 1: Caddy).
# Lo usa el límite de peticiones por IP cuando se fusione el PR #109.
# TRUST_PROXY=1
