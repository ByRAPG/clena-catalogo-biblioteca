# Base de datos
POSTGRES_USER=clena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clena_catalogo
DATABASE_URL=postgresql://clena:change-me@db:5432/clena_catalogo?schema=public

# API
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Autenticación
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=7d

# Correo (Mailpit en local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Biblioteca CLENA <no-reply@clena.local>"

# Préstamos
LOAN_DEFAULT_DAYS=8
LOAN_DUE_SOON_HOURS=48

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
