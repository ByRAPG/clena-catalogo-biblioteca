# Base de datos
POSTGRES_USER=clena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clena_catalogo
DATABASE_URL=postgresql://clena:change-me@db:5432/clena_catalogo?schema=public

# API
NODE_ENV=development
PORT=3000
# Orígenes permitidos, separados por coma. No admite * (la API usa cookies con credenciales)
CORS_ORIGIN=http://localhost:5173
# Proxies inversos de confianza para leer la IP real (X-Forwarded-For): false o un entero (p. ej. 1 en Render/Railway)
TRUST_PROXY=false
# Límite de peticiones por IP: THROTTLE_LIMIT cada THROTTLE_TTL_SECONDS; /auth/* usa THROTTLE_AUTH_LIMIT
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=20
# URL pública del frontend; los QR impresos apuntan aquí (HU-05)
PUBLIC_WEB_URL=http://localhost:5173
LOG_LEVEL=info

# Autenticación
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=7d

# Correo (Mailpit en local)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Biblioteca CLENA <no-reply@clena.local>"

# Préstamos
LOAN_DEFAULT_DAYS=8
LOAN_DUE_SOON_HOURS=48

# Búsqueda semántica (ADR-08)
# off: solo búsqueda léxica. EMBEDDING_PROVIDER: fake (pruebas y CI) o local (modelo real, aún no implementado)
SEMANTIC_SEARCH=off
EMBEDDING_PROVIDER=fake
# Reindexado de embeddings (solo con SEMANTIC_SEARCH=on): segundos entre pasadas (0 = solo al arrancar) y obras por lote
SEMANTIC_REINDEX_INTERVAL_SECONDS=300
SEMANTIC_REINDEX_BATCH_SIZE=16
# Consulta semántica: tiempo máximo del modelo (ms; al superarlo se responde solo con la léxica), inferencias simultáneas (las demás degradan), tamaño de la caché de embeddings de consulta (0 la desactiva) y su vigencia en segundos
SEMANTIC_TIMEOUT_MS=800
SEMANTIC_MAX_CONCURRENCY=2
SEMANTIC_CACHE_SIZE=500
SEMANTIC_CACHE_TTL_SECONDS=600
# Calidad de la semántica (calibrados para multilingual-e5-small; repetir `pnpm search:eval` si cambia el modelo): similitud coseno mínima para contar un resultado vectorial, distancia máxima al mejor resultado (1 la desactiva) y peso de la búsqueda léxica en la fusión
SEARCH_MIN_SIMILARITY=0.84
SEARCH_RELATIVE_CUTOFF=0.04
SEARCH_LEXICAL_WEIGHT=2

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
VITE_ALLOWED_HOST=localhost

# Semilla de demostración (solo desarrollo; nunca uses esta contraseña en producción)
SEED_DEMO_PASSWORD=demo-password-only-for-dev
