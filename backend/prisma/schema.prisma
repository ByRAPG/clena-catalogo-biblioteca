generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabla mínima del esqueleto (T-02). El modelo de datos real se define en T-06.
model SchemaInfo {
  id        Int      @id @default(autoincrement())
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("schema_info")
}