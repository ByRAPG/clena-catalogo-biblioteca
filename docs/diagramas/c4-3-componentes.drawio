<mxfile host="app.diagrams.net"><diagram id="c4-3-componentes" name="c4-3-componentes"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="g" value="API REST · NestJS (contenedor)" style="rounded=1;dashed=1;fillColor=none;strokeColor=#444444;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="640" height="700" as="geometry"/></mxCell><mxCell id="pres" value="&lt;b&gt;Controladores REST + guards&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[NestJS presentation]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DTO validados, JwtAuthGuard, RolesGuard, decoradores Swagger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="240" height="110" as="geometry"/></mxCell><mxCell id="iam" value="&lt;b&gt;Módulo iam&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[NestJS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Autenticación JWT access+refresh, roles, consentimiento, eliminar cuenta (HU-09, 16, 17, 18)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="260" height="120" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;Módulo catalog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[NestJS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Obras, autores, ejemplares, ubicación, importación CSV (HU-10, 11, 12, 19)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="260" height="120" as="geometry"/></mxCell><mxCell id="sea" value="&lt;b&gt;Módulo search&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[NestJS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Búsqueda tolerante, filtros, detalle y disponibilidad (HU-01, 02, 03, 06, 07, 08, 13)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="260" height="120" as="geometry"/></mxCell><mxCell id="loa" value="&lt;b&gt;Módulo loans&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[NestJS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Préstamos, devoluciones, reservas, alertas (HU-14, 20, 21)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="570" width="260" height="120" as="geometry"/></mxCell><mxCell id="dom" value="&lt;b&gt;Dominio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[TypeScript puro]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Entidades, value objects y reglas; sin NestJS ni Prisma&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="230" width="220" height="110" as="geometry"/></mxCell><mxCell id="inf" value="&lt;b&gt;Adaptadores de infraestructura&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Prisma, JWT, SMTP, CSV]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Implementan los puertos; mapean modelos de Prisma a entidades&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="400" width="220" height="120" as="geometry"/></mxCell><mxCell id="sh" value="&lt;b&gt;Compartido (shared)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[NestJS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Configuración validada, filtro global de errores, logs, salud, correo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="570" width="220" height="120" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PostgreSQL 16]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Datos del catálogo y de las cuentas&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="190" height="120" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SMTP / Mailpit]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Alertas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#6B6477;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1060" y="570" width="190" height="100" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Aplicación web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[React]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cliente de la API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="240" height="90" as="geometry"/></mxCell><mxCell id="e0" value="REST/JSON [HTTPS]" style="endArrow=block;html=1;rounded=0;strokeColor=#444444;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="web" target="pres"><mxGeometry relative="1" as="geometry"/>