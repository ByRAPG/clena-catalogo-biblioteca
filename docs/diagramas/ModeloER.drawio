        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USER ||--o{ REFRESH_TOKEN : has\n    USER ||--o| READER : linked_to\n    USER ||--o{ LOAN : registers\n    USER ||--o{ IMPORT_JOB : creates\n\n    READER ||--o{ LOAN : borrows\n    READER ||--o{ RESERVATION : makes\n    READER ||--o{ AVAILABILITY_ALERT : subscribes\n\n    CATEGORY ||--o{ WORK : categorizes\n\n    WORK ||--o{ WORK_AUTHOR : has\n    AUTHOR ||--o{ WORK_AUTHOR : participates\n\n    WORK ||--o{ WORK_SUBJECT : has\n    SUBJECT ||--o{ WORK_SUBJECT : classifies\n\n    WORK ||--o{ COPY : contains\n    WORK ||--o{ RESERVATION : receives\n    WORK ||--o{ AVAILABILITY_ALERT : generates\n\n    ROOM ||--o{ SECTION : contains\n    SECTION ||--o{ SHELF : contains\n    SHELF ||--o{ COPY : stores\n\n    COPY ||--o{ LOAN : has\n    COPY ||--o{ RESERVATION : receives\n\n    LOAN ||--o{ NOTIFICATION : generates\n\n    USER {\n        UUID id PK\n        VARCHAR email UK\n        VARCHAR password_hash\n        VARCHAR full_name\n        ENUM role\n        BOOLEAN active\n        INTEGER failed_logins\n        TIMESTAMP locked_until\n        VARCHAR privacy_version\n        TIMESTAMP consent_at\n        TIMESTAMP anonymized_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    REFRESH_TOKEN {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR token_hash UK\n        UUID family_id\n        TIMESTAMP expires_at\n        TIMESTAMP revoked_at\n        TIMESTAMP created_at\n    }\n\n    READER {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR full_name\n        VARCHAR document_id\n        VARCHAR email\n        VARCHAR phone\n        VARCHAR privacy_version\n        TIMESTAMP consent_at\n        TIMESTAMP anonymized_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    CATEGORY {\n        UUID id PK\n        VARCHAR name\n        VARCHAR normalized_name UK\n        TIMESTAMP created_at\n    }\n\n    WORK {\n        UUID id PK\n        VARCHAR title\n        VARCHAR subtitle\n        INTEGER year\n        VARCHAR publisher\n        VARCHAR isbn UK\n        VARCHAR classification\n        UUID category_id FK\n        ENUM material_type\n        ENUM format\n        VARCHAR digital_url\n        TEXT search_text\n        TIMESTAMP deleted_at\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    AUTHOR {\n        UUID id PK\n        VARCHAR name\n        VARCHAR normalized_name UK\n        TIMESTAMP created_at\n    }\n\n    SUBJECT {\n        UUID id PK\n        VARCHAR name\n        VARCHAR normalized_name UK\n        TIMESTAMP created_at\n    }\n\n    WORK_AUTHOR {\n        UUID work_id PK, FK\n        UUID author_id PK, FK\n        INTEGER position\n    }\n\n    WORK_SUBJECT {\n        UUID work_id PK, FK\n        UUID subject_id PK, FK\n    }\n\n    ROOM {\n        UUID id PK\n        VARCHAR name UK\n        TEXT map_svg\n        TIMESTAMP created_at\n    }\n\n    SECTION {\n        UUID id PK\n        UUID room_id FK\n        VARCHAR name\n        TIMESTAMP created_at\n    }\n\n    SHELF {\n        UUID id PK\n        UUID section_id FK\n        VARCHAR code\n        VARCHAR map_element_id\n        TIMESTAMP created_at\n    }\n\n    COPY {\n        UUID id PK\n        UUID work_id FK\n        UUID shelf_id FK\n        VARCHAR inventory_code UK\n        ENUM status\n        TIMESTAMP created_at\n        TIMESTAMP updated_at\n    }\n\n    LOAN {\n        UUID id PK\n        UUID copy_id FK\n        UUID reader_id FK\n        UUID staff_id FK\n        TIMESTAMP loaned_at\n        TIMESTAMP due_at\n        TIMESTAMP returned_at\n    }\n\n    RESERVATION {\n        UUID id PK\n        UUID work_id FK\n        UUID copy_id FK\n        UUID reader_id FK\n        ENUM status\n        TIMESTAMP reserved_at\n        TIMESTAMP expires_at\n        TIMESTAMP resolved_at\n    }\n\n    NOTIFICATION {\n        UUID id PK\n        UUID loan_id FK\n        ENUM type\n        TIMESTAMP created_at\n        TIMESTAMP sent_at\n        TEXT error\n    }\n\n    AVAILABILITY_ALERT {\n        UUID id PK\n        UUID reader_id FK\n        UUID work_id FK\n        TIMESTAMP created_at\n        TIMESTAMP notified_at\n    }\n\n    IMPORT_JOB {\n        UUID id PK\n        UUID user_id FK\n        VARCHAR file_name\n        INTEGER created\n        INTEGER updated\n        INTEGER failed\n        JSON errors\n        TIMESTAMP created_at\n    }\n    &quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="PH7s8OgCfzLrCd1cOCj3-1">
